---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ol class="test">
  {items.map((item) => <li>{item}</li>)}
</ol>

<style>
  .test {
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    counter-reset: test;
  }

  li {
    counter-increment: test;
    padding-inline-start: 2rem;
    color: var(--ink);
  }

  li + li {
    margin-top: 0.5rem;
  }

  li::before {
    content: "0" counter(test);
    display: inline-block;
    width: 2rem;
    margin-inline-start: -2rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    color: var(--slop-mid);
  }
</style>
