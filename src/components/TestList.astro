---
import Copy from './Copy.astro';
import type { TestItem } from '../i18n/types';

interface Props {
  items: TestItem[];
}

const { items } = Astro.props;
---

<ol class="test">
  {
    items.map((item) => (
      <li>
        <strong>{item.question}</strong> <Copy text={item.text} />
      </li>
    ))
  }
</ol>

<style>
  .test {
    padding-inline-start: 1.35rem;
  }

  li + li {
    margin-block-start: 0.4rem;
  }
</style>
