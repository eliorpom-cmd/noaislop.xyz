---
import Copy from './Copy.astro';
import type { TestItem } from '../i18n/types';

interface Props {
  items: TestItem[];
}

const { items } = Astro.props;
---

<ol class="test">
  {
    items.map((item) => (
      <li>
        <strong>{item.question}</strong> <Copy text={item.text} />
      </li>
    ))
  }
</ol>

<style>
  .test {
    margin: 18px 0 16px 20px;
    padding: 0;
    list-style: none;
    counter-reset: test;
    font-size: 18px;
    line-height: 24px;
    color: var(--muted);
  }

  li {
    counter-increment: test;
    margin-bottom: 10px;
  }

  li::before {
    content: counter(test) ".";
    padding-right: 10px;
    font-weight: 700;
    color: var(--card-title);
  }

  li strong {
    color: var(--text);
  }
</style>
