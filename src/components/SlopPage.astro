---
// The whole page, shared by every locale route. Everything it renders comes
// from src/content/i18n/{locale}.json, never from hardcoded strings.
// One column, one measure: a title, a hairline, and the text under it.
import BaseLayout from '../layouts/BaseLayout.astro';
import Copy from './Copy.astro';
import CopyLink from './CopyLink.astro';
import Definition from './Definition.astro';
import EmphasisBox from './EmphasisBox.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import PromptList from './PromptList.astro';
import Standards from './Standards.astro';
import TestList from './TestList.astro';
import TopBanner from './TopBanner.astro';
import { getCopy } from '../i18n/utils';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
---

<BaseLayout locale={locale}>
  <TopBanner
    locale={locale}
    prompt={copy.languageSwitcher.prompt}
    switcherLabel={copy.languageSwitcher.label}
  />

  <main class="container">
    <Hero title={copy.hero.h1} subtitle={copy.hero.subtitle} />

    <section class="section" aria-labelledby="definition">
      <h2 class="section-title" id="definition">{copy.definition.sectionTitle}</h2>
      <Definition
        word={copy.definition.word}
        partOfSpeech={copy.definition.partOfSpeech}
        text={copy.definition.text}
        source={copy.definition.source}
      />
      {copy.definition.body.map((paragraph) => <p><Copy text={paragraph} /></p>)}
    </section>

    <section class="section" aria-labelledby="dont">
      <h2 class="section-title" id="dont">{copy.dont.sectionTitle}</h2>
      <p><Copy text={copy.dont.intro} /></p>
      <PromptList prompts={copy.dont.prompts} stamp={copy.dont.stamp} />
      <p><Copy text={copy.dont.lede} /></p>
      {copy.dont.body.map((paragraph) => <p><Copy text={paragraph} /></p>)}
    </section>

    <section class="section" aria-labelledby="standards">
      <h2 class="section-title" id="standards">{copy.standards.sectionTitle}</h2>
      {copy.standards.body.map((paragraph) => <p><Copy text={paragraph} /></p>)}
      <PromptList
        prompts={[copy.standards.example.prompt]}
        stamp={copy.standards.example.stamp}
        tone="fine"
      />
      <Standards blocks={copy.standards.blocks} />
    </section>

    <section class="section" aria-labelledby="test">
      <h2 class="section-title" id="test">{copy.test.sectionTitle}</h2>
      <TestList items={copy.test.items} />
      <p><Copy text={copy.test.outro} /></p>
    </section>

    <EmphasisBox quote={copy.emphasis} />

    <section class="section" aria-labelledby="share">
      <h2 class="section-title section-title--plain" id="share">{copy.share.sectionTitle}</h2>
      <CopyLink
        domain={copy.share.domain}
        hint={copy.share.hint}
        copied={copy.share.copied}
        copyLabel={copy.share.copyLabel}
      />
    </section>
  </main>

  <Footer lines={copy.footer.lines} note={copy.footer.note} />
</BaseLayout>


