---
// The whole page, shared by every locale route. Everything it renders comes
// from src/content/i18n/{locale}.json, never from hardcoded strings.
// The layout follows nohello.net: 1100px container, a tall hero, then rows of
// section title on the left and content on the right.
import BaseLayout from '../layouts/BaseLayout.astro';
import Copy from './Copy.astro';
import CopyLink from './CopyLink.astro';
import CostList from './CostList.astro';
import DefinitionCard from './DefinitionCard.astro';
import EmphasisBox from './EmphasisBox.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import PromptCard from './PromptCard.astro';
import Standards from './Standards.astro';
import TestList from './TestList.astro';
import TopBanner from './TopBanner.astro';
import { getCopy } from '../i18n/utils';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
---

<BaseLayout locale={locale}>
  <TopBanner locale={locale} switcherLabel={copy.languageSwitcher.label} />

  <main class="container">
    <Hero title={copy.hero.h1} subtitle={copy.hero.subtitle} lead={copy.banner} />

    <section class="row" aria-labelledby="definition">
      <div class="col col--left">
        <h2 class="section-title" id="definition">{copy.definition.sectionTitle}</h2>
      </div>
      <div class="col col--right">
        <DefinitionCard
          word={copy.definition.word}
          partOfSpeech={copy.definition.partOfSpeech}
          text={copy.definition.text}
          source={copy.definition.source}
        />
        {copy.definition.body.map((paragraph) => <p><Copy text={paragraph} /></p>)}
      </div>
    </section>

    <section class="row" aria-labelledby="dont">
      <div class="col col--left">
        <h2 class="section-title" id="dont">{copy.dont.sectionTitle}</h2>
        <p class="caption"><Copy text={copy.dont.caption} /></p>
      </div>
      <div class="col col--right">
        {
          copy.dont.cards.map((card, index) => (
            <PromptCard
              card={card}
              stamp={copy.dont.stamp}
              chrome={copy.dont.chrome}
              index={index}
            />
          ))
        }
      </div>
    </section>

    <section class="row" aria-labelledby="cost">
      <div class="col col--left">
        <h2 class="section-title" id="cost">{copy.cost.sectionTitle}</h2>
      </div>
      <div class="col col--right">
        <p><Copy text={copy.cost.lede} /></p>
        <CostList items={copy.cost.items} />
      </div>
    </section>

    <section class="row" aria-labelledby="standards">
      <div class="col col--left">
        <h2 class="section-title" id="standards">{copy.standards.sectionTitle}</h2>
      </div>
      <div class="col col--right">
        {copy.standards.body.map((paragraph) => <p><Copy text={paragraph} /></p>)}
        <Standards blocks={copy.standards.blocks} />
      </div>
    </section>

    <EmphasisBox quote={copy.emphasis} />

    <section class="row" aria-labelledby="test">
      <div class="col col--left">
        <h2 class="section-title" id="test">{copy.test.sectionTitle}</h2>
      </div>
      <div class="col col--right">
        <p>{copy.test.intro}</p>
        <TestList items={copy.test.items} />
        <p><Copy text={copy.test.outro} /></p>
      </div>
    </section>

    <section class="row" aria-labelledby="share">
      <div class="col col--left">
        <h2 class="section-title" id="share">{copy.share.sectionTitle}</h2>
      </div>
      <div class="col col--right">
        <p><Copy text={copy.share.body} /></p>
        <CopyLink
          domain={copy.share.domain}
          hint={copy.share.hint}
          copied={copy.share.copied}
          copyLabel={copy.share.copyLabel}
        />
      </div>
    </section>
  </main>

  <Footer lines={copy.footer.lines} note={copy.footer.note} />
</BaseLayout>

<style>
  .caption {
    margin-top: 15px;
    font-size: 18px;
    line-height: 26px;
    color: var(--muted);
  }

  .col--right > :global(.card:first-child) {
    margin-top: 0;
  }
</style>
