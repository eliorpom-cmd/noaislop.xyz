---
import Copy from './Copy.astro';

interface Props {
  lines: string[];
  note: string;
}

const { lines, note } = Astro.props;
---

<footer class="footer">
  <div class="footer__inner">
    {
      lines.map((line) => (
        <p>
          <Copy text={line} />
        </p>
      ))
    }
    <p class="footer__note">{note}</p>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(180deg, #fff 0%, var(--footer-bg) 45%);
    font-size: 14px;
    font-weight: 300;
    line-height: 22px;
    color: var(--muted);
  }

  .footer__inner {
    max-width: 1100px;
    margin-inline: auto;
    padding: 150px 15px 80px;
  }

  .footer p {
    font-size: 14px;
    line-height: 22px;
    color: var(--muted);
  }

  .footer p + p {
    margin-top: 8px;
  }

  .footer__note {
    margin-top: 20px;
  }

  .footer a {
    color: var(--footer-link);
    text-decoration: underline;
  }

  .footer a:hover {
    text-decoration: none;
  }

  @media (max-width: 425px) {
    .footer__inner {
      padding: 90px 15px 60px;
    }
  }
</style>
