---
interface Props {
  lines: string[];
  note: string;
}

const { lines, note } = Astro.props;
---

<footer class="footer">
  <div class="wrap">
    {lines.map((line) => <p>{line}</p>)}
    <p class="footer__note">{note}</p>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: 3.25rem;
    padding-block: 1.75rem 3.5rem;
    border-block-start: 1px solid var(--rule);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  p + p {
    margin-block-start: 0.4rem;
  }

  .footer__note {
    margin-block-start: 1.1rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 3px solid var(--slop);
    color: var(--ink-faint);
  }
</style>
