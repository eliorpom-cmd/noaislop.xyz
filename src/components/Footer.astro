---
import Copy from './Copy.astro';

interface Props {
  lines: string[];
  note: string;
}

const { lines, note } = Astro.props;
---

<footer class="footer">
  <div class="footer__inner container">
    {
      lines.map((line) => (
        <p>
          <Copy text={line} />
        </p>
      ))
    }
    <p class="footer__note"><Copy text={note} /></p>
  </div>
</footer>

<style>
  .footer {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .footer__inner {
    padding-block: 3.5rem 5rem;
    border-top: 1px solid var(--rule);
  }

  .footer p {
    font-size: inherit;
    color: var(--muted);
  }

  .footer p + p {
    margin-top: 0.25rem;
  }

  .footer__note {
    margin-top: 1.5rem;
  }

  .footer :global(a) {
    color: var(--muted);
  }

  .footer :global(a:hover) {
    color: var(--ink);
  }
</style>
