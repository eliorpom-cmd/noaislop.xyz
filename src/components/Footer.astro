---
import Copy from './Copy.astro';

interface Props {
  lines: string[];
  note: string;
}

const { lines, note } = Astro.props;
---

<footer class="footer">
  <div class="wrap">
    {
      lines.map((line) => (
        <p>
          <Copy text={line} />
        </p>
      ))
    }
    <p class="footer__note">{note}</p>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: 2.75rem;
    padding-block: 1.25rem 3rem;
    border-block-start: 1px solid var(--rule);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--ink-faint);
  }

  p + p {
    margin-block-start: 0.35rem;
  }

  .footer__note {
    margin-block-start: 0.9rem;
  }
</style>
