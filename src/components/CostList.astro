---
import Copy from './Copy.astro';
import type { CostItem } from '../i18n/types';

interface Props {
  items: CostItem[];
}

const { items } = Astro.props;
---

<dl class="costs">
  {
    items.map((item) => (
      <div class="costs__item">
        <dt>{item.title}</dt>
        <dd>
          <Copy text={item.text} />
        </dd>
      </div>
    ))
  }
</dl>

<style>
  /* Run-in headings: the bold bit starts the sentence and carries the point. */
  .costs__item + .costs__item {
    margin-block-start: 0.8rem;
  }

  dt,
  dd {
    display: inline;
    margin: 0;
  }

  dt {
    font-weight: 700;
  }

  dd::before {
    content: " ";
  }
</style>
