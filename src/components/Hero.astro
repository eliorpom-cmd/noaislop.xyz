---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<div class="hero">
  <h1 class="hero__title">{title}</h1>
  <p class="hero__subtitle">{subtitle}</p>
</div>

<style>
  .hero__title {
    font-size: clamp(2.75rem, 1rem + 9vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 800;
  }

  .hero__subtitle {
    margin-block-start: 0.6rem;
    font-size: 1.25rem;
    color: var(--ink-soft);
  }

  @media (max-width: 30rem) {
    .hero__subtitle {
      font-size: 1.125rem;
    }
  }
</style>
