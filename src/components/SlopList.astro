---
interface Props {
  prompts: string[];
  stamp: string;
}

const { prompts, stamp } = Astro.props;
---

<ul class="slops">
  {
    prompts.map((prompt) => (
      <li>
        <span class="slops__prompt">{prompt}</span>
        <span class="slops__arrow" aria-hidden="true">
          →
        </span>
        <span class="slops__stamp">{stamp}</span>
      </li>
    ))
  }
</ul>

<style>
  .slops {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .slops li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    padding-block: 0.55rem;
  }

  .slops__prompt {
    color: var(--text);
  }

  .slops__stamp {
    margin-inline-start: auto;
  }

  .slops__arrow {
    font-size: 1.125rem;
    line-height: 1;
    color: var(--muted);
  }

  /* The one flourish left on the page: the word, in a face that drips. Its
     glyphs hang below the baseline, so the box is centred on the ink, not on
     the drips. */
  .slops__stamp {
    display: inline-block;
    font-family: var(--font-drip);
    font-size: 1.375rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--slop);
    -webkit-text-stroke: 1px var(--slop-deep);
    translate: 0 -0.12em;
  }
</style>
