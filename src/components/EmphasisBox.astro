---
interface Props {
  quote: string;
}

const { quote } = Astro.props;
---

<p class="pull"><strong>{quote}</strong></p>

<style>
  .pull {
    margin-block-start: 2.75rem;
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  @media (max-width: 30rem) {
    .pull {
      font-size: 1.125rem;
    }
  }
</style>
