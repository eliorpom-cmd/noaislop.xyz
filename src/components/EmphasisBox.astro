---
interface Props {
  quote: string;
}

const { quote } = Astro.props;
---

<blockquote class="pull">
  <p>{quote}</p>
</blockquote>

<style>
  .pull {
    padding-block: 3.25rem;
  }

  .pull p {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5.5vw, 2rem);
    line-height: 1.15;
    color: var(--slop-mid);
    text-wrap: balance;
  }

  @media (max-width: 30rem) {
    .pull {
      padding-block: 2.5rem;
    }
  }
</style>
