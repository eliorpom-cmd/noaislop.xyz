---
import Copy from './Copy.astro';
import type { RunIn } from '../i18n/types';

interface Props {
  blocks: RunIn[];
}

const { blocks } = Astro.props;
---

<dl class="runin">
  {
    blocks.map((block) => (
      <div class="runin__item">
        <dt>{block.title}</dt>
        <dd>
          <Copy text={block.text} />
        </dd>
      </div>
    ))
  }
</dl>

<style>
  /* Run-in headings: the bold word starts the line and carries the point. */
  .runin {
    margin-top: 1.5rem;
  }

  .runin__item {
    color: var(--text);
  }

  .runin__item + .runin__item {
    margin-top: 0.75rem;
  }

  dt,
  dd {
    display: inline;
    margin: 0;
  }

  dt {
    font-weight: 600;
    color: var(--ink);
  }

  dd::before {
    content: " ";
  }
</style>
