---
import Copy from './Copy.astro';
import type { StandardsBlock } from '../i18n/types';

interface Props {
  blocks: StandardsBlock[];
}

const { blocks } = Astro.props;
---

<div class="standards">
  {
    blocks.map((block) => (
      <section class="standards__block">
        <h3>{block.title}</h3>
        <ul>
          {block.items.map((item) => (
            <li>
              <Copy text={item} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .standards__block + .standards__block {
    margin-block-start: 1.4rem;
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 700;
  }

  ul {
    margin-block-start: 0.4rem;
    padding-inline-start: 1.15rem;
  }

  li + li {
    margin-block-start: 0.3rem;
  }
</style>
