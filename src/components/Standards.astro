---
import Copy from './Copy.astro';
import type { StandardsBlock } from '../i18n/types';

interface Props {
  blocks: StandardsBlock[];
}

const { blocks } = Astro.props;
---

<div class="standards">
  {
    blocks.map((block) => (
      <section class="standards__block">
        <h3>{block.title}</h3>
        <ul class="marks marks--yes">
          {block.items.map((item) => (
            <li>
              <Copy text={item} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .standards {
    margin-top: 26px;
  }

  .standards__block + .standards__block {
    margin-top: 28px;
  }

  h3 {
    margin-bottom: 10px;
    font-size: 20px;
    font-weight: 700;
    line-height: 26px;
    color: var(--card-title);
  }
</style>
