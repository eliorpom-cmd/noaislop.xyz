---
interface Props {
  word: string;
  partOfSpeech: string;
  text: string;
  source: string;
}

const { word, partOfSpeech, text, source } = Astro.props;
---

<figure class="card entry">
  <dl>
    <dt>
      <b class="entry__word">{word}</b>
      <i class="entry__pos">({partOfSpeech})</i>
    </dt>
    <dd>{text}</dd>
  </dl>
  <figcaption class="entry__source">{source}</figcaption>
</figure>

<style>
  .entry {
    margin-top: 0;
  }

  dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 7px;
    margin-bottom: 8px;
  }

  .entry__word {
    font-size: 20px;
    font-weight: 700;
    color: var(--card-title);
  }

  .entry__pos {
    font-style: normal;
    font-size: 16px;
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-size: 18px;
    line-height: 26px;
    color: var(--text);
  }

  .entry__source {
    margin-top: 12px;
    font-size: 14px;
    font-weight: 300;
    color: var(--muted);
  }
</style>
