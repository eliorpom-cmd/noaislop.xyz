---
interface Props {
  domain: string;
  hint: string;
  copied: string;
  copyLabel: string;
}

const { domain, hint, copied, copyLabel } = Astro.props;
---

<div class="copy">
  <button
    class="copy__button"
    type="button"
    aria-label={copyLabel}
    data-copy
    data-value={domain}
    data-copied={copied}
    data-hint={hint}
  >
    <span class="copy__domain">{domain}</span>
    <span class="copy__hint" data-copy-hint>{hint}</span>
  </button>
  <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
</div>

<style>
  .copy {
    margin-top: 24px;
  }

  .copy__button {
    display: block;
    width: 100%;
    padding: 22px 20px;
    border: 0;
    border-radius: 10px;
    background: #fff;
    box-shadow: -20px 20px 60px #d9d9d9, 20px -20px 60px #fff;
    color: inherit;
    font: inherit;
    text-align: center;
    cursor: pointer;
  }

  .copy__domain {
    display: block;
    font-size: 34px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .copy__hint {
    display: block;
    margin-top: 8px;
    font-size: 16px;
    font-weight: 300;
    color: var(--link);
  }

  .copy__button:hover .copy__hint {
    text-decoration: underline;
  }

  .copy__button.is-copied .copy__hint {
    color: var(--slop-deep);
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 425px) {
    .copy__domain {
      font-size: 24px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const hintEl = button.querySelector<HTMLElement>('[data-copy-hint]');
    const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    const value = button.dataset.value ?? '';
    const copiedLabel = button.dataset.copied ?? '';
    const hintLabel = button.dataset.hint ?? '';
    let timer: number | undefined;

    // Older browsers, and any context where the async clipboard API refuses
    // (unfocused document, permission denied), still get a working button.
    function legacyCopy(text: string) {
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.append(field);
      field.select();
      let copied = false;
      try {
        copied = document.execCommand('copy');
      } catch {
        copied = false;
      }
      field.remove();
      return copied;
    }

    async function write(text: string) {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch {
        /* fall through to the legacy path */
      }
      return legacyCopy(text);
    }

    button.addEventListener('click', async () => {
      const copiedOk = await write(value);
      if (!copiedOk) return;
      if (hintEl) hintEl.textContent = copiedLabel;
      if (status) status.textContent = copiedLabel;
      button.classList.add('is-copied');
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (hintEl) hintEl.textContent = hintLabel;
        if (status) status.textContent = '';
        button.classList.remove('is-copied');
      }, 2400);
    });
  });
</script>
