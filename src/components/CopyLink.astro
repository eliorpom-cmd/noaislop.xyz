---
interface Props {
  domain: string;
  hint: string;
  copied: string;
  copyLabel: string;
}

const { domain, hint, copied, copyLabel } = Astro.props;
---

<div class="copy">
  <button
    class="copy__button"
    type="button"
    aria-label={copyLabel}
    data-copy
    data-value={domain}
    data-copied={copied}
    data-hint={hint}
  >
    <span class="copy__domain">{domain}</span>
    <span class="copy__hint" data-copy-hint>{hint}</span>
  </button>
  <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
</div>

<style>
  .copy__button {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    width: 100%;
    padding: 1.25rem 1.25rem;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .copy__button:hover {
    border-color: var(--slop-deep);
  }

  .copy__domain {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .copy__hint {
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* Copied: the whole box fills with the accent, no fade, no transition. The
     state speaks for itself. */
  .copy__button.is-copied {
    background: var(--slop);
    border-color: var(--slop-deep);
  }

  .copy__button.is-copied .copy__hint {
    color: var(--slop-deep);
    font-weight: 700;
  }

  @media (max-width: 30rem) {
    .copy__domain {
      font-size: 1.375rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const hintEl = button.querySelector<HTMLElement>('[data-copy-hint]');
    const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    const value = button.dataset.value ?? '';
    const copiedLabel = button.dataset.copied ?? '';
    const hintLabel = button.dataset.hint ?? '';
    let timer: number | undefined;

    // Older browsers, and any context where the async clipboard API refuses
    // (unfocused document, permission denied), still get a working button.
    function legacyCopy(text: string) {
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.append(field);
      field.select();
      let copied = false;
      try {
        copied = document.execCommand('copy');
      } catch {
        copied = false;
      }
      field.remove();
      return copied;
    }

    async function write(text: string) {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch {
        /* fall through to the legacy path */
      }
      return legacyCopy(text);
    }

    button.addEventListener('click', async () => {
      const copiedOk = await write(value);
      if (!copiedOk) return;
      if (hintEl) hintEl.textContent = copiedLabel;
      if (status) status.textContent = copiedLabel;
      button.classList.add('is-copied');
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (hintEl) hintEl.textContent = hintLabel;
        if (status) status.textContent = '';
        button.classList.remove('is-copied');
      }, 2400);
    });
  });
</script>
