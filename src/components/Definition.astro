---
interface Props {
  word: string;
  partOfSpeech: string;
  text: string;
  source: string;
}

const { word, partOfSpeech, text, source } = Astro.props;
---

<figure class="entry">
  <dl>
    <dt>
      <b class="entry__word">{word}</b>
      <i class="entry__pos">{partOfSpeech}</i>
    </dt>
    <dd>{text}</dd>
  </dl>
  <figcaption class="entry__source">{source}</figcaption>
</figure>

<style>
  /* A dictionary entry, set off by a rule instead of a card. */
  .entry {
    margin-bottom: 1.75rem;
    padding-inline-start: 1.25rem;
    border-inline-start: 2px solid var(--slop);
  }

  dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .entry__word {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .entry__pos {
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  dd {
    margin: 0;
    color: var(--text);
  }

  .entry__source {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
