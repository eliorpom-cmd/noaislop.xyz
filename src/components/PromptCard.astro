---
import type { PromptCard } from '../i18n/types';

interface Props {
  card: PromptCard;
  stamp: string;
  chrome: { assistant: string; composer: string };
  index: number;
}

const { card, stamp, chrome, index } = Astro.props;

// Hand-set per card. A stamp pressed three times is never pressed the same way.
const presses = [
  { angle: -7, offsetX: -4, offsetY: 0 },
  { angle: -3, offsetX: 6, offsetY: 4 },
  { angle: -10, offsetX: 0, offsetY: -2 },
];
const press = presses[index % presses.length];

// The stamp lands on the middle of the answer, and the answer is not always
// the full width of the column.
const centres = { text: '50%', image: '30%', video: '42%' };
const centre = centres[card.kind];
---

<!-- A generic assistant interface: no product name, no logo, no brand colours.
     role="img" + aria-label means the whole thing is announced as one
     alternative text, so none of the blurred filler is read out. -->
<figure class="card chat" role="img" aria-label={card.alt}>
  <div class="chat__head">
    <span class="chat__mark">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 2c.45 4.35 3.2 7.1 7.55 7.55C15.2 10 12.45 12.75 12 17.1c-.45-4.35-3.2-7.1-7.55-7.55C8.8 9.1 11.55 6.35 12 2z"
        ></path>
      </svg>
    </span>
    <span class="chat__name">{chrome.assistant}</span>
  </div>

  <p class="chat__user">{card.prompt}</p>

  <div class="chat__reply">
    <span class="chat__avatar">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 2c.45 4.35 3.2 7.1 7.55 7.55C15.2 10 12.45 12.75 12 17.1c-.45-4.35-3.2-7.1-7.55-7.55C8.8 9.1 11.55 6.35 12 2z"
        ></path>
      </svg>
    </span>

    <div class="chat__body" style={`--cx:${centre}`}>
      {
        card.kind === 'text' && (
          <div class="chat__text">
            {(card.reply ?? []).map((line) => (
              <p>{line}</p>
            ))}
          </div>
        )
      }

      {
        card.kind === 'image' && (
          <div class="media media--poster">
            <span class="frame frame--poster">
              <span class="poster__disc" />
              <span class="poster__hill" />
              <span class="poster__band" />
              <span class="poster__bar" />
              <span class="poster__bar poster__bar--short" />
            </span>
          </div>
        )
      }

      {
        card.kind === 'video' && (
          <div class="media media--video">
            <span class="frame frame--still">
              <span class="still__glow" />
              <span class="still__subject" />
              <span class="still__floor" />
            </span>
            <span class="player">
              <span class="player__play" />
              <span class="player__track" />
            </span>
          </div>
        )
      }

      <span
        class:list={['stamp', card.kind === 'text' && 'stamp--soaked']}
        style={`--angle:${press.angle}deg;--dx:${press.offsetX}px;--dy:${press.offsetY}px`}
      >
        {stamp}
      </span>
    </div>
  </div>

  <div class="chat__composer">
    <span class="chat__placeholder">{chrome.composer}</span>
    <span class="chat__send">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 19V5M12 5l-6 6M12 5l6 6" fill="none" stroke-width="2.4"></path>
      </svg>
    </span>
  </div>
</figure>

<style>
  .chat {
    font-size: 16px;
  }

  .chat__head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 14px;
    margin-bottom: 18px;
    border-bottom: 1px solid #ececec;
  }

  .chat__mark svg,
  .chat__avatar svg {
    display: block;
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  .chat__mark {
    color: var(--ink);
  }

  .chat__name {
    font-size: 14px;
    font-weight: 700;
    color: var(--muted);
  }

  .chat__user {
    max-width: 78%;
    margin-inline-start: auto;
    padding: 10px 16px;
    border-radius: 20px;
    background: #f4f4f4;
    color: var(--text);
    font-size: 16px;
    line-height: 24px;
    width: fit-content;
  }

  .chat__reply {
    display: flex;
    gap: 12px;
    margin-top: 22px;
  }

  .chat__avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid #e5e5e5;
    border-radius: 50%;
    color: var(--ink);
  }

  .chat__body {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .chat__text {
    color: var(--text);
    font-size: 16px;
    line-height: 26px;
    filter: blur(3.6px);
    user-select: none;
  }

  .chat__text p {
    font-size: 16px;
    line-height: 26px;
  }

  .chat__text p + p {
    margin-top: 14px;
  }

  .chat__composer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 24px;
    padding: 9px 9px 9px 18px;
    border: 1px solid #e5e5e5;
    border-radius: 24px;
  }

  .chat__placeholder {
    /* Placeholder grey, dark enough to clear AA even though it sits inside a
       reconstruction. */
    color: #757575;
    font-size: 16px;
  }

  .chat__send {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--ink);
  }

  .chat__send svg {
    display: block;
    width: 17px;
    height: 17px;
    stroke: #fff;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Image and video answers: a blurred picture, not blurred prose. --------- */

  .media {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
  }

  .media--poster {
    width: 46%;
    aspect-ratio: 4 / 5;
  }

  .media--video {
    width: 78%;
    aspect-ratio: 16 / 9;
  }

  .frame {
    position: absolute;
    inset: 0;
    /* Scaled up so the blur never drags the edges into view. Colour is pulled
       most of the way out: this is background, it should not pull the eye. */
    scale: 1.12;
    filter: blur(7px) saturate(0.12) brightness(1.16) contrast(0.88);
  }

  .frame span {
    position: absolute;
  }

  /* The default look of a machine that was asked for nothing in particular. */
  .frame--poster {
    background: linear-gradient(165deg, #7b57f0 0%, #d4508f 48%, #f2a53c 100%);
  }

  .poster__disc {
    inset-inline-start: 50%;
    inset-block-start: 18%;
    translate: -50% 0;
    width: 38%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffe9b8;
  }

  .poster__hill {
    inset-inline: -12%;
    inset-block-end: 24%;
    height: 36%;
    border-radius: 50% 50% 0 0;
    background: #3b1f6e;
  }

  .poster__band {
    inset-inline: 0;
    inset-block-end: 0;
    height: 26%;
    background: #1d1030;
  }

  .poster__bar {
    inset-inline-start: 9%;
    inset-block-end: 15%;
    width: 62%;
    height: 7%;
    border-radius: 2px;
    background: #ffd166;
  }

  .poster__bar--short {
    inset-block-end: 6%;
    width: 38%;
    height: 5%;
    background: #c9b8ea;
  }

  .frame--still {
    background: linear-gradient(180deg, #13334f 0%, #1f6f7d 62%, #2fa38a 100%);
  }

  .still__glow {
    inset-inline-start: 24%;
    inset-block-start: 8%;
    width: 34%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #cdf3e4;
    opacity: 0.55;
  }

  .still__subject {
    inset-inline-start: 38%;
    inset-block-end: 16%;
    width: 24%;
    height: 52%;
    border-radius: 46% 46% 26% 26%;
    background: #0f1f2c;
  }

  .still__floor {
    inset-inline: 0;
    inset-block-end: 0;
    height: 18%;
    background: #0c1a24;
  }

  /* Player chrome stays sharp: that is what says "this is a video". */
  .player {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    background: rgb(9 14 19 / 0.55);
  }

  .player__play {
    width: 0;
    height: 0;
    border-inline-start: 9px solid #fff;
    border-block: 6px solid transparent;
  }

  .player__track {
    position: relative;
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.35);
  }

  .player__track::after {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 38%;
    border-radius: 2px;
    background: #fff;
  }

  /* Stamped in a face that drips on its own. Decorative, aria-hidden by the
     role="img" on the card. */
  .stamp {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: var(--cx);
    translate: calc(-50% + var(--dx)) calc(-50% + var(--dy));
    rotate: var(--angle);
    font-family: var(--font-drip);
    font-size: 56px;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--slop);
    -webkit-text-stroke: 2px var(--slop-deep);
  }

  /* Over text the ink soaks in. Over a picture it sits on top, like a sticker. */
  .stamp--soaked {
    mix-blend-mode: multiply;
  }

  @media (max-width: 425px) {
    .stamp {
      font-size: 40px;
      -webkit-text-stroke-width: 1.5px;
    }

    .media--poster {
      width: 62%;
    }

    .media--video {
      width: 100%;
    }

    .chat__user {
      max-width: 88%;
    }
  }
</style>
