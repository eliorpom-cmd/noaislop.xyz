---
// The prompt, an arrow, and the verdict stamped right after it. The bad ones
// are stamped in the face that drips; the good one gets the marker face, so
// the two never read the same.
interface Props {
  prompts: string[];
  stamp: string;
  tone?: 'slop' | 'fine';
}

const { prompts, stamp, tone = 'slop' } = Astro.props;
---

<ul class:list={['prompts', tone === 'fine' && 'prompts--fine']}>
  {
    prompts.map((prompt) => (
      <li>
        <span class="prompts__text">{prompt}</span>
        <span class="prompts__arrow" aria-hidden="true">
          →
        </span>
        <span class="prompts__stamp">{stamp}</span>
      </li>
    ))
  }
</ul>

<style>
  .prompts {
    margin-block: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .prompts li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    padding-block: 0.55rem;
  }

  .prompts__text {
    color: var(--text);
  }

  .prompts__arrow {
    font-size: 1.125rem;
    line-height: 1;
    color: var(--muted);
  }

  /* The stamp: a face that drips. Its glyphs hang below the baseline, so the
     box is centred on the ink, not on the drips. */
  .prompts__stamp {
    display: inline-block;
    font-family: var(--font-drip);
    font-size: 1.375rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--slop);
    -webkit-text-stroke: 1px var(--slop-deep);
    translate: 0 -0.12em;
  }

  /* The good one is not slop, so it is not stamped like slop. */
  .prompts--fine .prompts__stamp {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--ink);
    -webkit-text-stroke: 0;
    translate: 0;
  }

  /* The good brief runs to three lines, so it flows as text and the verdict
     lands at the end of the last one, the way it does on the short ones. */
  .prompts--fine li {
    display: block;
  }

  .prompts--fine .prompts__arrow,
  .prompts--fine .prompts__stamp {
    margin-inline-start: 0.6rem;
    white-space: nowrap;
  }
</style>
