---
// One line above the title: the language question on the left, the two
// languages on the right. No rule under it, the title carries the top of the
// page on its own.
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: string;
  prompt: string;
  switcherLabel: string;
}

const { locale, prompt, switcherLabel } = Astro.props;
---

<div class="doc-meta container">
  <span>{prompt}</span>
  <LanguageSwitcher locale={locale} label={switcherLabel} />
</div>

<style>
  .doc-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-top: 2rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  @media (max-width: 30rem) {
    .doc-meta {
      margin-top: 1.25rem;
      font-size: 0.875rem;
    }
  }
</style>
