---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localePath } from '../i18n/utils';

interface Props {
  text: string;
  locale: string;
  switcherLabel: string;
}

const { text, locale, switcherLabel } = Astro.props;
---

<header class="masthead">
  <div class="wrap masthead__inner">
    <a class="masthead__name" href={localePath(locale)}>
      <span class="masthead__mark" aria-hidden="true">🤮</span>noaislop.xyz
    </a>
    <LanguageSwitcher locale={locale} label={switcherLabel} />
  </div>
</header>

<p class="notice">
  <span class="wrap">{text}</span>
</p>

<style>
  .masthead {
    border-block-end: 1px solid var(--rule);
  }

  .masthead__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 0.7rem;
  }

  .masthead__name {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }

  .masthead__name:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .masthead__mark {
    font-size: 1.0625rem;
    line-height: 1;
  }

  .notice .wrap {
    display: block;
    padding-block: 0.9rem 0;
    font-size: 0.875rem;
    color: var(--ink-faint);
  }
</style>
