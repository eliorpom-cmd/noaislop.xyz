---
import '../styles/global.css';
import { DEFAULT_LOCALE, locales } from '../i18n/config';
import { getAlternates, getCopy, localeUrl, SITE_URL } from '../i18n/utils';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const alternates = getAlternates();
const canonical = localeUrl(locale);
const ogImage = new URL('/og-image.png', SITE_URL).href;
const otherLocales = locales.filter((code) => code !== locale);
const isCanonicalPage = locale === DEFAULT_LOCALE;
---

<!doctype html>
<html lang={copy.meta.lang} dir={copy.meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="canonical" href={canonical} />

    <link
      rel="preload"
      href="/fonts/heros-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#a8c520" />

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="noaislop.xyz" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={copy.meta.ogTitle} />
    <meta property="og:description" content={copy.meta.ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.meta.ogImageAlt} />
    <meta property="og:locale" content={copy.meta.ogLocale} />
    {
      otherLocales.map((code) => (
        <meta property="og:locale:alternate" content={getCopy(code).meta.ogLocale} />
      ))
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.meta.ogTitle} />
    <meta name="twitter:description" content={copy.meta.ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={copy.meta.ogImageAlt} />

    <!-- Umami Cloud: page views only, no cookie, no personal data. Drop this
         line and the site tracks nothing at all. -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="23362f42-f810-473d-8131-4c246dfd51c4"></script>

    {
      isCanonicalPage && (
        <script is:inline define:vars={{ locales, DEFAULT_LOCALE }}>
          // Canonical page only. Sends a first-time visitor to their language
          // if we have it, once, and never again after that. Runs before the
          // body is parsed, so there is nothing to flash.
          try {
            var KEY = 'noaislop:lang';
            if (!localStorage.getItem(KEY)) {
              var wanted = navigator.languages || [navigator.language || ''];
              for (var i = 0; i < wanted.length; i++) {
                var base = String(wanted[i] || '')
                  .toLowerCase()
                  .split('-')[0];
                if (locales.indexOf(base) === -1) continue;
                localStorage.setItem(KEY, base);
                if (base !== DEFAULT_LOCALE) location.replace('/' + base + '/');
                break;
              }
            }
          } catch (error) {
            /* storage blocked: stay on the canonical page */
          }
        </script>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
